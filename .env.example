# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prasad_cement_products?schema=public"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-refresh-secret-change-in-production"
JWT_REFRESH_EXPIRES_IN="30d"

# ─── OTP ──────────────────────────────────────────────────────────────────────
# In development, OTP is always 123456
# In production, set OTP_PROVIDER to "twilio", "msg91", or "2factor"
OTP_PROVIDER="mock"
OTP_EXPIRY_MINUTES=5

# Twilio (if OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Google Maps ──────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=""

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# ─── Upload ───────────────────────────────────────────────────────────────────
# "local" for dev filesystem, "cloudinary" for production
UPLOAD_PROVIDER="local"
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10
